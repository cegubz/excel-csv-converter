# ============================================================================
#  excel-to-csv-foundry-agent  —  configuration
#  Local dev: copy to `.env`. On Foundry: these are declared in azure.yaml and
#  injected into the hosted-agent container at runtime.
# ============================================================================

# ---- Azure Blob Storage -----------------------------------------------------
# Storage account holding the uploaded Excel files.
AZURE_STORAGE_ACCOUNT_URL=https://<youraccount>.blob.core.windows.net

# Container where the incoming .xlsx files live.
INPUT_CONTAINER=incoming

# Container where generated .csv files are written (can equal INPUT_CONTAINER).
OUTPUT_CONTAINER=converted

# Optional virtual-folder prefix for outputs, e.g. "csv/" -> converted/csv/...
OUTPUT_PREFIX=

# OPTIONAL local-dev fallback only. In Azure use Managed Identity (leave unset).
# AZURE_STORAGE_CONNECTION_STRING=

# ---- Output naming / logging ------------------------------------------------
# {stem} = excel filename without extension; {sheet} = sanitized sheet name.
CSV_NAME_TEMPLATE={stem}__{sheet}.csv
LOG_LEVEL=INFO

# ---- Injected by Foundry at runtime (do NOT set manually in Azure) ----------
# FOUNDRY_PROJECT_ENDPOINT is auto-injected into hosted agents. Only set it
# locally if you extend this into the Responses/model path (see README).
FOUNDRY_PROJECT_ENDPOINT=https://aif-schemaupd-dev-aue-001.services.ai.azure.com/api/projects/aif-schemaupd-dev-aue-proj
